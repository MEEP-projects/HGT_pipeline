# Extract species names from file names
species_names <- gsub(
    basename(sam_files),
    pattern = "_.+[.]sam", replacement = ""
)
species_names
coverage_list <- list()
# Loop through each .sam file and calculate coverage
for (sam_file in sam_files) {
    # Read the SAM file
    param <- ScanBamParam(what = scanBamWhat())
    alignments <- readGAlignments(sam_file, param = param)
    
    # Calculate coverage
    coverage <- coverage(alignments)
    
    # Convert coverage to a data frame for plotting
    coverage_list[[sam_file]] <- as.data.frame(coverage)
    
}
q()
