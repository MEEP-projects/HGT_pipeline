# number of loci to plot
n <- 100
# allelic dropout probability
d <- 0.001
# Set up dataframe
SNPs <- as.data.frame(c(0:n))
# Second column is number of SNP mismatches (i.e. number of homozygotes)
colnames(SNPs) <- "homs"
# Log likelihood ratios (not accounting for s)
SNPs$mismatch_logLR <- (log(d, base = 10)) * (SNPs$homs)
SNPs$match_logLR <- (log(2, base = 10)) * (n-SNPs$homs)
SNPs$cumulative_logLR <- SNPs$mismatch_logLR + SNPs$match_logLR
# Likelihood ratios
SNPs$LR <- 10^(SNPs$cumulative_logLR)
# Plot cumulative log likelihood
ggplot(SNPs, aes(x=homs, y=cumulative_logLR)) +
theme_bw() +
geom_point()
# Plot all likelihoods
SNPs_long <- SNPs %>%
pivot_longer(cols = c(mismatch_logLR, match_logLR, cumulative_logLR),
names_to = "logLR",
values_to = "value")
ggplot(SNPs_long, aes(x = homs, y = value, colour = logLR)) +
geom_point(size = 0.8) +
labs(
title = paste("Distribution of likelihoods across hypothetical", n, "SNP dataset"),
subtitle = paste("Using allelic dropout rate (d) =", d),
x = "Number of homozygote mismatches",
y = "log LR",
) +
theme_minimal()
#homs mismatch_logLR match_logLR cumulative_logLR        LR
#12   11      -27.75167    26.79167       -0.9599966 0.1096487
# 10.66%
10^(((log(d, base = 10)) * (10.66)) + ((log(2, base = 10)) * (100-10.66)))
