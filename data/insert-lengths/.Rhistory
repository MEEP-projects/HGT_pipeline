source("~/Documents/TRACE/Black-rhino/SNP-analysis/3.population genetic dataset_2/sequioa/add_dummy_par.R")
# Adding dummy parents
ped_input2 <- add_dummy(ped_input, missing_ids = c("BLR087","BLR158","BLR195","BLR320","BLR342"))
# Rerun
ped <- pedigree(id = ped_input2$id, dadid = ped_input2$sire, momid = ped_input2$dam, sex = ped_input2$Sex)
# ERROR: Subjects must have both a father and mother, or have neither BLR343 BLR346 BLR347 BLR112 BLR131
# Adding dummy parents
ped_input3 <- add_dummy(ped_input2, missing_ids = c("BLR343","BLR346","BLR347","BLR112","BLR131"))
# Rerun
ped <- pedigree(id = ped_input3$id, dadid = ped_input3$sire, momid = ped_input3$dam, sex = ped_input3$Sex)
# ERROR: Subjects must have both a father and mother, or have neither BLR228 BLR239 BLR255 BLR275 BLR328
# Adding dummy parents
ped_input4 <- add_dummy(ped_input3, missing_ids = c("BLR228","BLR239","BLR255","BLR275","BLR328"))
# Rerun
ped <- pedigree(id = ped_input4$id, dadid = ped_input4$sire, momid = ped_input4$dam, sex = ped_input4$Sex)
# ERROR: Subjects must have both a father and mother, or have neither BLR355 BLR322 BLR331 BLR348
# Adding dummy parents
ped_input5 <- add_dummy(ped_input4, missing_ids = c("BLR355","BLR322","BLR331","BLR348"))
# Rerun
ped <- pedigree(id = ped_input5$id, dadid = ped_input5$sire, momid = ped_input5$dam, sex = ped_input5$Sex)
## Plot
kinship2::plot.pedigree(ped, cex = 0.25, width = 15)
kinship2::plot.pedigree(ped, cex = 0.1, width = 15)
kinship2::plot.pedigree(ped, cex = 0.25, width = 15, height = 8)
kinship2::plot.pedigree(ped, cex = 0.25, width = 15, height = 50)
kinship2::plot.pedigree(ped, cex = 0.25, width = 15, height = 50)
