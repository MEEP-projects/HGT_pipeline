library(kinship2)
library(kinship2)
library(dplyr)
## Preparing input file
# Get rid of excess columns and add sex (male, female, unknown). Life history file for the above is coded as 1=female, 2=male.
SeqOUT <- read.csv("sequoia-results_version1.csv", header = TRUE)
# Adding the sex column from the life history file to the Sequioa results file, removing excess columns, and recoding the sex column
ped_input <- SeqOUT %>%
left_join(LiHis1, by = c("id" = "ID")) %>%
select(-X, -LLRdam, -LLRsire, -LLRpair, -LLRpair, -OHdam, -OHsire, -MEpair, -BY, -BY.min, -BY.max) %>%
mutate(Sex = case_when(Sex == 1 ~ "female", Sex == 2 ~ "male", is.na(Sex) ~ "unknown", TRUE ~ as.character(Sex)))
# Adding the sex column from the life history file to the Sequioa results file, removing excess columns, and recoding the sex column
ped_input <- SeqOUT %>%
left_join(LiHis1, by = c("id" = "ID")) %>%
select(-X, -LLRdam, -LLRsire, -LLRpair, -LLRpair, -OHdam, -OHsire, -MEpair, -BY) %>%
mutate(Sex = case_when(Sex == 1 ~ "female", Sex == 2 ~ "male", is.na(Sex) ~ "unknown", TRUE ~ as.character(Sex)))
# Run pedigree
ped <- pedigree(id = ped_input$id, dadid = ped_input$sire, momid = ped_input$dam, sex = ped_input$Sex)
LiHis1 <- read.csv("sequoia_metadata_black_rhino_run1.csv", header = TRUE)
rm(SeqOUT_v1)
# to check --> Module = "pre"
# To run full model --> Module = "ped"
