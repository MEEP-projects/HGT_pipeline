library(dplyr)
library(data.table)
library(ggplot2)
library(stringr)
# Read the annotated marker file (skip comment line if present)
markers <- fread("7.1.audited_annotated_combined.tsv", sep = "\t", header = TRUE, comment.char = "#")
# Read the annotated marker file (skip comment line if present)
markers <- fread("7.1.audited_annotated_combined.tsv", sep = "\t", header = TRUE)
markers
# Ensure expected columns are present
colnames(markers) <- c("index", "chromosome", "start", "end", "feature_type",
"details", "reads", "genome")
# Calculate marker length
markers[, length := end - start]
# Add a simpler classification column
markers[, region_type := ifelse(feature_type == "intergenic", "intergenic", "genic")]
# Summary stats
mean(markers$length)
median(markers$length)
min(markers$length)
max(markers$length)
ggplot(markers, aes(x = length, fill = region_type)) +
geom_histogram(bins = 50, color = "black", alpha = 0.6, position = "identity") +
scale_fill_manual(values = c("intergenic" = "steelblue", "genic" = "darkorange")) +
theme_minimal(base_size = 16) +
labs(
x = "Marker Length (bp)",
y = "Number of Markers",
fill = "Region Type",
title = "Marker Length Distribution (Overall vs Intergenic)"
) +
theme(
plot.title = element_text(size = 20, hjust = 0.5, face = "bold"),
axis.line = element_line(color = "black", linewidth = 1)
)
ggplot(markers, aes(x = length, fill = region_type)) +
geom_density(alpha = 0.5, adjust = 1.2) +
scale_fill_manual(values = c("intergenic" = "steelblue", "genic" = "darkorange")) +
scale_x_continuous(
limits = c(50, 1000),
breaks = seq(50, 1000, by = 100),
expand = c(0, 0)
) +
scale_y_continuous(expand = expansion(mult = c(0, 0.05))) +
geom_hline(yintercept = 0, color = "black") +
geom_vline(xintercept = 0, color = "black") +
labs(
x = "Marker Length (bp)",
y = "Density",
fill = "Region Type",
title = "Marker Length Distribution (Intergenic vs Genic)"
) +
theme_classic(base_size = 18) +
theme(
panel.grid = element_blank(),
plot.title = element_text(size = 22, hjust = 0.5, face = "bold"),
axis.title.x = element_text(size = 20, vjust = -0.2),
axis.title.y = element_text(size = 20, vjust = 1.5),
axis.text = element_text(size = 16),
axis.line = element_line(colour = "black", linewidth = 1)
)
# Count of markers over 1000 bp
markers[length > 1000, .N]
dim(markers)
library(dplyr)
library(data.table)
library(ggplot2)
library(stringr)
# Read the annotated marker file (skip comment line if present)
markers <- fread("7.1.audited_annotated_combined.tsv", sep = "\t", header = TRUE)
# Ensure expected columns are present
colnames(markers) <- c("index", "chromosome", "start", "end", "feature_type",
"details", "reads", "genome")
# Calculate marker length
markers[, length := end - start]
# Add a classification column
markers[, region_type := ifelse(feature_type == "intergenic", "intergenic", "genic")]
# Create separate datasets
markers_all <- markers %>% mutate(region_type = "all")
markers_combined <- rbind(markers_all, markers)
# Plot combined density lines (no fill)
ggplot(markers_combined, aes(x = length, color = region_type)) +
geom_density(size = 1.2, adjust = 1.2) +
scale_color_manual(
values = c("all" = "black", "intergenic" = "steelblue", "genic" = "darkorange"),
name = "Region Type"
) +
scale_x_continuous(
limits = c(50, 1000),
breaks = seq(50, 1000, by = 100),
expand = c(0, 0)
) +
scale_y_continuous(expand = expansion(mult = c(0, 0.05))) +
geom_hline(yintercept = 0, color = "black") +
geom_vline(xintercept = 0, color = "black") +
labs(
x = "Marker Length (bp)",
y = "Density",
title = "Marker Length Distribution (All, Intergenic, and Genic)"
) +
theme_classic(base_size = 18) +
theme(
panel.grid = element_blank(),
plot.title = element_text(size = 22, hjust = 0.5, face = "bold"),
axis.title.x = element_text(size = 20, vjust = -0.2),
axis.title.y = element_text(size = 20, vjust = 1.5),
axis.text = element_text(size = 16),
axis.line = element_line(colour = "black", linewidth = 1),
legend.position = "top",
legend.title = element_text(size = 18),
legend.text = element_text(size = 16)
)
# Plot combined density lines
ggplot(markers_combined, aes(x = length, color = region_type)) +
geom_density(size = 1.2, adjust = 1.2, alpha = 0.6) +
scale_color_manual(
values = c("all" = "grey40", "intergenic" = "steelblue", "genic" = "darkorange"),
name = "Region Type"
) +
scale_x_continuous(
limits = c(50, 1000),
breaks = seq(50, 1000, by = 100),
expand = c(0, 0)
) +
scale_y_continuous(expand = expansion(mult = c(0, 0.05))) +
geom_hline(yintercept = 0, color = "black") +
geom_vline(xintercept = 0, color = "black") +
labs(
x = "Marker Length (bp)",
y = "Density",
title = "Marker Length Distribution (All, Intergenic, and Genic)"
) +
theme_classic(base_size = 18) +
theme(
panel.grid = element_blank(),
plot.title = element_text(size = 22, hjust = 0.5, face = "bold"),
axis.title.x = element_text(size = 20, vjust = -0.2),
axis.title.y = element_text(size = 20, vjust = 1.5),
