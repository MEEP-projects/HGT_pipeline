Module = "ped",
Err = 1e-023,
args.AP = list(MinAgeParent = c(5, 5), MaxAgeParent = c(45, 45)),
MaxSibshipSize = 20,
Complex = "full")
# assigned 42 dams and 41 sires to 98 + 10 individuals (real + dummy)
SeqOUT_v1$TotLikSib
